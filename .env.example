# Copy to .env and adjust. The server and seed load .env automatically (server/env.js).
# All values are optional — the defaults below are used when a line is missing.

# HTTP port (server listens on 0.0.0.0 so phones on the LAN can open QR links)
PORT=3093

# Set to production to serve the built client from dist/ (same as `npm start`)
# NODE_ENV=production

# Database: sqlite (default, a file) or mssql (Microsoft SQL Server). Uploads always go to data/uploads/
DB_CLIENT=sqlite

# SQLite database file (relative to the project folder), used when DB_CLIENT=sqlite
# DB_PATH=data/it_storage.db

# SQL Server, used when DB_CLIENT=mssql. Needs a SQL login (Windows authentication is not supported);
# create one with docs/create-app-login.mssql.sql. Tables are created on first start if missing.
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=ITAM
MSSQL_USER=itam_app
MSSQL_PASSWORD=
# Named instance (e.g. SQLEXPRESS) instead of a port; leave empty for the default instance
# MSSQL_INSTANCE=
# Encrypt the connection (1 for remote/Azure servers); trust the server's self-signed certificate
MSSQL_ENCRYPT=0
MSSQL_TRUST_CERT=1

# Set to 1 when the app is served over HTTPS (behind a reverse proxy) to mark the session cookie Secure
COOKIE_SECURE=0
